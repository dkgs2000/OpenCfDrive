<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!--
    Per-user: the drive is registered per user, so OpenCfDrive installs into
    %LOCALAPPDATA%\Programs\OpenCfDrive without administrator rights. Files in
    a user profile need an HKCU registry value as each component's key path,
    and such components need a fixed Guid (never change one once released).
  -->
  <Package Name="OpenCfDrive"
           Manufacturer="OpenCfDrive contributors"
           Version="$(var.Version)"
           UpgradeCode="EDC64FFF-9ECA-4514-8D88-DD813C5083D8"
           Scope="perUser"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of OpenCfDrive is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="OpenCfDrive.ico" SourceFile="$(var.RepoRoot)assets\opencfdrive.ico" />
    <Property Id="ARPPRODUCTICON" Value="OpenCfDrive.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="OpenCfDrive" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="ServiceExe" Guid="5513EE6C-CFF6-4354-8956-168DFC206698">
        <File Id="ServiceExe" Source="$(var.PublishDir)OpenCfDrive.Service.exe" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\OpenCfDrive" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveUserProgramsFolder" Directory="UserProgramsFolder" On="uninstall" />
      </Component>
      <Component Id="AppSettings" Guid="781E880C-0B24-494A-BFFF-00B974ABEE8E">
        <File Source="$(var.PublishDir)appsettings.json" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\OpenCfDrive" Name="AppSettings" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="Notices" Guid="82608352-AA2F-4421-BE86-86754ACB1EA9">
        <File Source="$(var.RepoRoot)LICENSE" Name="LICENSE.txt" KeyPath="no" />
        <File Source="$(var.RepoRoot)installer\THIRD-PARTY-NOTICES.txt" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\OpenCfDrive" Name="Notices" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="OpenCfDriveShortcut"
                  Name="OpenCfDrive"
                  Description="Start the OpenCfDrive cloud drive"
                  Target="[INSTALLFOLDER]OpenCfDrive.Service.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="OpenCfDrive.ico" />
        <RegistryValue Root="HKCU" Key="Software\OpenCfDrive" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="OpenCfDrive">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!--
      Before the files go: stop the running copy. On a real uninstall (not the
      old version's removal during an upgrade) also unregister the drive, which
      removes its Explorer entry and leaves an ordinary folder.
    -->
    <CustomAction Id="StopOpenCfDrive" FileRef="ServiceExe" ExeCommand="--stop"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="UnregisterOpenCfDrive" FileRef="ServiceExe" ExeCommand="--stop --unregister"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="StopOpenCfDrive" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND UPGRADINGPRODUCTCODE" />
      <Custom Action="UnregisterOpenCfDrive" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
